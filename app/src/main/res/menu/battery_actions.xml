    <item
        android:id="@+id/action_battery_status"
        android:title="@string/battery_status"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_battery_clear"
        android:title="@string/battery_clear_history"
        app:showAsAction="never" />
