    <item
        android:id="@+id/action_battery_columns"
        android:icon="@drawable/ic_grid_3x3"
        android:title="@string/list_layout"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_battery_sample_now"
        android:icon="@drawable/ic_refresh"
        android:title="@string/battery_sample_now"
        app:showAsAction="ifRoom" />
    <item
        android:id="@+id/action_battery_screen_off"
