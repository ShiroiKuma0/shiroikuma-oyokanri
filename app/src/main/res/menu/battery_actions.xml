<!-- Fork: battery-history screen actions. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:id="@+id/action_battery_search"
        android:icon="@drawable/ic_search"
        android:title="@string/search"
        app:actionViewClass="androidx.appcompat.widget.SearchView"
        app:showAsAction="ifRoom|collapseActionView" />
    <item
        android:id="@+id/action_battery_window"
        android:icon="@drawable/ic_history"
        android:title="@string/battery_window"
        app:showAsAction="ifRoom" />
    <item
        android:id="@+id/action_battery_sort"
        android:icon="@drawable/ic_sort"
        android:title="@string/battery_sort"
        app:showAsAction="ifRoom" />
