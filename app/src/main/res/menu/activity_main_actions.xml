<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:id="@+id/action_instructions"
        android:icon="@drawable/ic_information"
        android:title="@string/user_manual"
        app:showAsAction="never" />

    <!-- Fork: process monitor / reaper entry. Standalone gauge icon to the
         LEFT of the filter icon, with a trailing gap (custom actionLayout) so
         it reads as its own control. Click wired in MainActivity. -->
    <item
        android:id="@+id/action_process_monitor"
        android:icon="@drawable/ic_monitor"
        android:title="@string/monitor_title"
        app:actionLayout="@layout/view_toolbar_monitor"
        app:showAsAction="always" />

    <!-- Fork: battery-history entry, beside the monitor gauge. The monitor
         answers "what is burning CPU right now"; this answers "what drained
         the battery while I was not looking". -->
    <item
        android:id="@+id/action_battery_history"
        android:icon="@drawable/ic_battery_history"
        android:title="@string/battery_title"
        app:showAsAction="always" />

    <!-- Fork: per-app screen time / data usage, immediately right of the
         battery icon — the third "where did it go" screen beside the monitor
         (CPU right now) and the battery history (drain over time). "always",
         like every other top-bar entry here: "ifRoom" silently drops into the
         overflow on a narrow/folded panel, which defeats the point of putting
         it on the bar. Hidden by onPrepareOptionsMenu when usage access is
         disabled. -->
    <item
        android:id="@+id/action_app_usage"
        android:icon="@drawable/ic_data_usage"
        android:title="@string/app_usage"
        app:showAsAction="always" />

    <!-- Fork: clear-all-filters, immediately LEFT of the filter funnel it
         undoes, so the pair reads as set/reset. -->
    <item
        android:id="@+id/action_clear_filters"
        android:icon="@drawable/ic_filter_clear"
        android:title="@string/clear_all_filters"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_list_options"
        android:icon="@drawable/ic_filter"
        android:title="@string/list_options"
        app:showAsAction="always" />

    <!-- Fork: copy-displayed-app-IDs moved off the top toolbar into the
         overflow (was ifRoom with ic_content_copy); the 3x3 layout icon
         takes its toolbar slot. Feature stays reachable from the overflow. -->
    <item
        android:id="@+id/action_export_displayed_ids"
        android:icon="@drawable/ic_content_copy"
        android:title="@string/copy_displayed_app_ids"
        app:showAsAction="never" />

    <!-- Fork: main-list layout picker (adaptive / 2 / 3 / 4 columns). "always",
         not "ifRoom": on a narrow/folded panel there was no room left by the
         time it was reached and it silently fell into the overflow, which is
         where 白い熊 kept finding it. It is the last item before the overflow,
         so it renders immediately left of the ⋮ button. -->
    <item
        android:id="@+id/action_layout_columns"
        android:icon="@drawable/ic_grid_3x3"
        android:title="@string/list_layout"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_refresh"
        android:icon="@drawable/ic_refresh"
        android:title="@string/refresh"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_one_click_ops"
        android:icon="@drawable/ic_cursor_default_click"
        android:title="@string/one_click_ops" />

    <item
        android:id="@+id/action_finder"
        android:icon="@drawable/ic_search"
        android:title="@string/finder_title" />

    <item
        android:id="@+id/action_profiles"
        android:icon="@drawable/ic_file_document_multiple"
        android:title="@string/profiles" />

    <item
        android:id="@+id/action_apk_updater"
        android:icon="@drawable/ic_sync"
        android:title="@string/apk_updater" />

    <item
        android:id="@+id/action_debloater"
        android:icon="@drawable/ic_liquid_spot_off"
        android:title="@string/debloater_title" />

    <item
        android:id="@+id/action_labs"
        android:icon="@drawable/ic_package"
        android:title="@string/title_labs_activity" />

    <item
        android:id="@+id/action_settings"
        android:icon="@drawable/ic_settings"
        android:title="@string/app_settings" />

</menu>