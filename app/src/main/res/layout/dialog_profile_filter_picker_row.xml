<!--
    One row in the multi-profile filter picker dialog. Profile name on
    the left, then two pill buttons: "+" (include) and "-" (exclude).

    Every visual surface here (row background, name colour, the two
    pills) is styled programmatically in MainListOptions per the row's
    tri-state value (neutral / include / exclude), so the views are
    deliberately plain - plain TextViews for the pills rather than
    Material Chips, because the states need fills, double borders and
    line-highlights that the Chip checked/unchecked machinery can't
    express. The pills are clickable on their own (toggle that polarity)
    and the whole row is clickable (cycles neutral -> include ->
    exclude -> neutral).
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/profile_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="凍結" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btn_include"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:minWidth="52dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="18dp"
        android:paddingVertical="6dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:text="+" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btn_exclude"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:minWidth="52dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="18dp"
        android:paddingVertical="6dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:text="−" />

</androidx.appcompat.widget.LinearLayoutCompat>
