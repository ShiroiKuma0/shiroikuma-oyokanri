<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: the device-policy card pinned to the top of the Snooping tab. States
     whether we hold Device Owner powers at all, and carries the hard freeze
     (suspend) — the one control on this page that is not a capability but a
     verdict on the whole app. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.AppTheme.CardView.ListItem.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="?attr/listItemMarginHorizontal"
    android:layout_marginVertical="?attr/listItemMarginVertical"
    app:cardElevation="0dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="?attr/listItemPaddingHorizontal"
        android:paddingVertical="?attr/listItemPaddingVertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/policy_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:textAppearance="?android:attr/textAppearanceListItem"
            android:textStyle="bold"
            tools:text="Device policy powers active" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/policy_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textSize="13sp"
            tools:text="Locks set here cannot be undone from Settings." />

        <!-- The hard freeze. Its own row inside the card, because it is the one
             thing here that acts on the whole app rather than one capability. -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/policy_suspend_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/policy_suspend_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:textAppearance="?android:attr/textAppearanceListItem"
                    tools:text="Suspend this app" />

                <!-- Bold, directly under the row's own title: what this actually is.
                     It is not a warning — suspension is released by this same
                     switch — it is the one fact that distinguishes it from the
                     freeze on the main list. -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/policy_suspend_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="A stronger freeze than hiding: the app cannot be opened at all." />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/policy_suspend_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_snooping_chip"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textSize="13sp"
                    tools:text="Cannot be opened at all. Settings offers no way back." />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/policy_suspend_toggle"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="0"
                android:clickable="false"
                android:focusable="false" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Fork: the two ordinary verdicts on the whole app, under the hard one
             (白い熊). Neither needs device policy — they are what the main list's
             snowflake and the App info page already do — so unlike everything
             else on this card they stay visible with no Device Owner in sight.
             Pills rather than rows: they are actions, and three lines of prose
             each pushed the capability list off the first screen. The account
             they used to carry lives behind the "i", which is where an
             explanation you read once belongs. -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/policy_app_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Half the card each, so the two pills line up with the two columns
                 the capability list breaks into when the phone is unfolded. The
                 weights are why the missing one goes INVISIBLE rather than GONE
                 below: a lone pill would otherwise stretch across the whole card. -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/policy_freeze_pill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="6dp"
                android:paddingVertical="6dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/policy_freeze_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_snowflake" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/policy_freeze_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="Freeze" />

                <!-- The explanation, one tap away. Its own hit target, so tapping
                     the pill still does the thing the pill names. -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/policy_freeze_info"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/policy_freeze"
                    android:padding="5dp"
                    android:src="@drawable/ic_information_circle" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/policy_uninstall_pill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="6dp"
                android:paddingVertical="6dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/policy_uninstall_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_trash_can" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/policy_uninstall_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="Uninstall" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/policy_uninstall_info"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/policy_uninstall"
                    android:padding="5dp"
                    android:src="@drawable/ic_information_circle" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- The rest of the device-policy powers, 2×2 (白い熊, +75). They used to
             live behind a "More device-policy controls…" pill that opened a list
             dialog — which hid, among other things, the way back ("Clear all
             locks") behind two taps and a menu nobody would think to open. As
             boxes they are visible, and each one SHOWS ITS STATE, which a menu
             line structurally cannot.

             Two per row rather than four full-width rows: this card sits above
             the capability list and would otherwise push it off the first
             screen entirely. -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/policy_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/policy_box_uninstall"
                    layout="@layout/view_policy_control_box"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/policy_box_user_control"
                    layout="@layout/view_policy_control_box"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/policy_box_accessibility"
                    layout="@layout/view_policy_control_box"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/policy_box_clear"
                    layout="@layout/view_policy_control_box"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

</com.google.android.material.card.MaterialCardView>
