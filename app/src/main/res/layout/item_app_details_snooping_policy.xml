<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: the device-policy card pinned to the top of the Snooping tab. States
     whether we hold Device Owner powers at all, and carries the hard freeze
     (suspend) — the one control on this page that is not a capability but a
     verdict on the whole app. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.AppTheme.CardView.ListItem.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="?attr/listItemMarginHorizontal"
    android:layout_marginVertical="?attr/listItemMarginVertical"
    app:cardElevation="0dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="?attr/listItemPaddingHorizontal"
        android:paddingVertical="?attr/listItemPaddingVertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/policy_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:textAppearance="?android:attr/textAppearanceListItem"
            android:textStyle="bold"
            tools:text="Device policy powers active" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/policy_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textSize="13sp"
            tools:text="Locks set here cannot be undone from Settings." />

        <!-- The hard freeze. Its own row inside the card, because it is the one
             thing here that acts on the whole app rather than one capability. -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/policy_suspend_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/policy_suspend_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:textAppearance="?android:attr/textAppearanceListItem"
                    tools:text="Suspend this app" />

                <!-- Bold, directly under the row's own title: what this actually is.
                     It is not a warning — suspension is released by this same
                     switch — it is the one fact that distinguishes it from the
                     freeze on the main list. -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/policy_suspend_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="A stronger freeze than hiding: the app cannot be opened at all." />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/policy_suspend_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_snooping_chip"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textSize="13sp"
                    tools:text="Cannot be opened at all. Settings offers no way back." />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/policy_suspend_toggle"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="0"
                android:clickable="false"
                android:focusable="false" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- The rest of the device-policy powers, 2×2 (白い熊, +75). They used to
             live behind a "More device-policy controls…" pill that opened a list
             dialog — which hid, among other things, the way back ("Clear all
             locks") behind two taps and a menu nobody would think to open. As
             boxes they are visible, and each one SHOWS ITS STATE, which a menu
             line structurally cannot.

             Two per row rather than four full-width rows: this card sits above
             the capability list and would otherwise push it off the first
             screen entirely. -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/policy_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/policy_box_uninstall"
                    layout="@layout/view_policy_control_box"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/policy_box_user_control"
                    layout="@layout/view_policy_control_box"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/policy_box_accessibility"
                    layout="@layout/view_policy_control_box"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/policy_box_clear"
                    layout="@layout/view_policy_control_box"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

</com.google.android.material.card.MaterialCardView>
