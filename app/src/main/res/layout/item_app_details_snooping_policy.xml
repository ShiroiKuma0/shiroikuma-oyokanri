<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: the device-policy card pinned to the top of the Snooping tab. States
     whether we hold Device Owner powers at all, and carries the controls that are
     not capabilities but verdicts on the whole app: the Freeze sub-box (白い熊,
     +032 — master switch plus the four gates as numbered steps) and uninstall. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.AppTheme.CardView.ListItem.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="?attr/listItemMarginHorizontal"
    android:layout_marginVertical="?attr/listItemMarginVertical"
    app:cardElevation="0dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="?attr/listItemPaddingHorizontal"
        android:paddingVertical="?attr/listItemPaddingVertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/policy_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:textAppearance="?android:attr/textAppearanceListItem"
            android:textStyle="bold"
            tools:text="Device policy powers active" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/policy_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textSize="13sp"
            tools:text="Locks set here cannot be undone from Settings." />

        <!-- Fork (白い熊, +032): freezing, as its own sub-box. It carries what used
             to be the "Suspend this app" row and the "Freeze" pill, plus the two
             gates that had no control at all. Unlike the boxes further down it is
             NOT gated on a delegation: three of its four steps need only the
             shell, and the box is also the page's explanation of what a freeze
             does — which is worth reading on a phone with no Device Owner. -->
        <!-- No layout_width/height here ON PURPOSE. LayoutInflater.parseInclude
             takes the <include>'s own layout params whenever it can build them,
             and falls back to the included root's only when that throws — which
             is exactly what a missing layout_width does. Specifying them here
             would therefore silently DROP the card's own layout_marginTop and
             leave the box butted against the summary above it. -->
        <include
            android:id="@+id/policy_freeze_box"
            layout="@layout/view_freeze_box" />

        <!-- Fork: uninstall, the other verdict on the whole app (白い熊). It needs
             no device policy — it is what the App info page already does — so
             unlike everything else on this card it stays visible with no Device
             Owner in sight. A pill rather than a row: it is an action, and three
             lines of prose pushed the capability list off the first screen. The
             account it used to carry lives behind the "i", which is where an
             explanation you read once belongs. Freeze stood beside it until +032
             and is now the sub-box above. -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/policy_app_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Half the card, so the pill lines up with the left of the two
                 columns the capability list breaks into when the phone is
                 unfolded. The weight is why it goes INVISIBLE rather than GONE
                 below: GONE would let the spacer take the whole row. -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/policy_uninstall_pill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="6dp"
                android:paddingVertical="6dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/policy_uninstall_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_trash_can" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/policy_uninstall_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="Uninstall" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/policy_uninstall_info"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/policy_uninstall"
                    android:padding="5dp"
                    android:src="@drawable/ic_information_circle" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- Uninstall is alone here since freezing moved into its own box, but
                 it keeps half the card: the pill lines up with the left column of
                 the boxes below and of the capability list, and a lone pill
                 stretched across the whole width reads as a banner. -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- The rest of the device-policy powers, 2×2 (白い熊, +75). They used to
             live behind a "More device-policy controls…" pill that opened a list
             dialog — which hid, among other things, the way back ("Clear all
             locks") behind two taps and a menu nobody would think to open. As
             boxes they are visible, and each one SHOWS ITS STATE, which a menu
             line structurally cannot.

             Two per row rather than four full-width rows: this card sits above
             the capability list and would otherwise push it off the first
             screen entirely. -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/policy_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/policy_box_uninstall"
                    layout="@layout/view_policy_control_box"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/policy_box_user_control"
                    layout="@layout/view_policy_control_box"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/policy_box_accessibility"
                    layout="@layout/view_policy_control_box"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/policy_box_clear"
                    layout="@layout/view_policy_control_box"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

</com.google.android.material.card.MaterialCardView>
