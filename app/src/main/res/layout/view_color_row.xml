<!--
    One colour role under a font element: a swatch, the role label, and the
    current value (hex, or "Default" when unset). Whole row taps to open the
    colour picker. Added programmatically in FontsPreferences.bindElement.
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:paddingVertical="6dp">

    <View
        android:id="@+id/cr_swatch"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="12dp" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/cr_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#9A9A9A"
        android:textSize="14sp"
        tools:text="Colour (has trackers)" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/cr_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/theme_bright_yellow"
        android:textSize="15sp"
        tools:text="#FF7A1A" />

</androidx.appcompat.widget.LinearLayoutCompat>
