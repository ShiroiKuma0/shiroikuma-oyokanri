<!-- Fork (白い熊, +123): the 白い熊 応用管理 UI screen — a screen of its own with its own title,
     no longer a page inside Settings. Hosts fonts/FontsPreferences. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fork_ground">

    <include layout="@layout/appbar" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/ui_settings_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
