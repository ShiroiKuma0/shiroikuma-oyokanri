<!-- Fork: in-app batch-operation progress dialog. The container background and
     every text/indicator colour are applied at runtime from the configurable
     fork theme (ForkThemeUtils), so no colours are hard-coded here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/batch_progress_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/batch_progress_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="Freeze" />

    <TextView
        android:id="@+id/batch_progress_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="15sp"
        tools:text="12 / 30" />

    <!-- Fork: the app currently being processed — label in bold, id in italics. -->
    <TextView
        android:id="@+id/batch_progress_current_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="App Manager" />

    <TextView
        android:id="@+id/batch_progress_current_package"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="13sp"
        android:textStyle="italic"
        tools:text="io.github.muntashirakon.AppManager" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/batch_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:trackCornerRadius="4dp"
        app:trackThickness="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/batch_progress_pause"
            style="@style/Widget.AppTheme.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pause" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/batch_progress_cancel"
            style="@style/Widget.AppTheme.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/cancel" />
    </LinearLayout>
</LinearLayout>
