<!-- Fork: in-app batch-operation progress dialog. The container background and
     every text/indicator colour are applied at runtime from the configurable
     fork theme (ForkThemeUtils), so no colours are hard-coded here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/batch_progress_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/batch_progress_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="Backup" />

    <TextView
        android:id="@+id/batch_progress_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="15sp"
        tools:text="52 / 550 · 9%" />

    <!-- Fork: elapsed, estimate, in-flight count, bytes written, failures. What a
         counter alone cannot say during an hour-long backup. -->
    <TextView
        android:id="@+id/batch_progress_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.8"
        android:textSize="13sp"
        tools:text="12m 04s elapsed · about 1h 48m left · 8 running · 1.4 GB written" />

    <!-- Fork: the apps in flight right now. Capped so eight concurrent backups
         cannot push Pause and Cancel off the screen; the ceiling is set in code
         from the window height (BatchProgressDialog#show). -->
    <io.github.muntashirakon.AppManager.main.MaxHeightScrollView
        android:id="@+id/batch_progress_item_scroller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fadeScrollbars="false"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/batch_progress_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </io.github.muntashirakon.AppManager.main.MaxHeightScrollView>

    <!-- Shown instead of the list between apps, and while paused. -->
    <TextView
        android:id="@+id/batch_progress_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:alpha="0.75"
        android:textSize="13sp"
        android:textStyle="italic"
        android:visibility="gone"
        tools:text="Paused — apps already started will finish." />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/batch_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:trackCornerRadius="4dp"
        app:trackThickness="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/batch_progress_pause"
            style="@style/Widget.AppTheme.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pause" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/batch_progress_cancel"
            style="@style/Widget.AppTheme.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/cancel" />
    </LinearLayout>
</LinearLayout>
