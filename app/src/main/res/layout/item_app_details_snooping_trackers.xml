<?xml version="1.0" encoding="utf-8"?>
<!-- Fork (白い熊, +147): the trackers card, pinned above the device-policy card on the Snooping
     tab. It is framed exactly like that card — same outlined style, same margins, same inner
     padding — because the two are the page's two banners and a section that framed itself
     differently would read as a different kind of thing. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.AppTheme.CardView.ListItem.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="?attr/listItemMarginHorizontal"
    android:layout_marginVertical="?attr/listItemMarginVertical"
    app:cardElevation="0dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/trackers_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="?attr/listItemPaddingHorizontal"
        android:paddingVertical="?attr/listItemPaddingVertical" />

</com.google.android.material.card.MaterialCardView>
