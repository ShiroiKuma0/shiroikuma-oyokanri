<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.AppTheme.CardView.ListItem.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:checkable="true"
    app:cardBackgroundColor="@android:color/black">

    <!-- Fork (白い熊, +118): the card is now a COLUMN — the row itself, and under it the pane
         that a tap unrolls. The pane is part of the row rather than an extra item inserted into
         the adapter, because every selection call in MultiSelectionView.Adapter is keyed by
         ADAPTER POSITION: an inserted row would shift every position after it and quietly
         corrupt the selection. Width in a grid is handled by a span-size lookup instead, which
         touches no data at all. -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="?attr/listItemPaddingHorizontal"
        android:paddingVertical="?attr/listItemPaddingVertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/icon_column"
            android:layout_width="@dimen/main_list_icon_size"
            android:layout_height="match_parent"
            android:gravity="center"
            android:layout_marginEnd="@dimen/padding_small"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon"
                android:layout_width="@dimen/main_list_icon_size"
                android:layout_height="@dimen/main_list_icon_size"
                android:layout_gravity="center_horizontal"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                tools:srcCompat="@mipmap/ic_launcher_round"
                android:contentDescription="@string/str_logo" />
            <!-- Fork, +82: the icon is clickable in its own right — it opens the
                 app's Snooping page. The rest of the column below it still
                 toggles freeze, so the two do not compete for the same pixels. -->


            <!-- Fork: freeze (snowflake) and force-stop (✕) indicators on one
                 line in the whitespace under the icon. The snowflake is pinned
                 to the left (close to the card's box edge); the yellow ✕ to the
                 right, both the same size. A weighted gap between them keeps the
                 two tap targets apart so one isn't mis-hit when aiming for the
                 other. The ✕ (kill_badge) shows only for running apps and
                 force-stops the app on a single tap, with no confirmation. -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/freeze_indicator"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_snowflake_outline_24dp"
                    android:visibility="visible"
                    tools:ignore="ContentDescription"
                    tools:tint="@color/theme_bright_yellow" />

                <!-- Fork (白い熊, +034, moved beside the glyph +036): which gate is
                     the deepest one standing, as a numbered ring the same size as
                     the snowflake it sits next to. It began at the snowflake's
                     corner and overlapped it, which cost the digit most of its
                     size; beside it, at the glyph's own 26dp, it is simply
                     legible.

                     It fits because it can never share the line with the ✕: that
                     one is shown only for a RUNNING app (installed, not frozen,
                     not stopped — see MainRecyclerAdapter), which is precisely
                     freeze level 0, and this badge appears only from level 1 up.

                     The ring and both colours are built in code
                     (FreezeLevelBadge), because the ramp is configurable like
                     every other colour on this row. includeFontPadding off, or
                     the digit sits high in its circle. -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/freeze_level_badge"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="3dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="3"
                    tools:visibility="visible" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/kill_badge"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close_24dp"
                    android:contentDescription="@string/force_stop"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/backup_indicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:text="@string/backup"
                tools:ignore="SmallSp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Fork: 0dp, not match_parent. With match_parent each child's base
             width is the whole row, so the weights distribute NEGATIVE leftover
             space and the heavier column shrinks the most — which is why the
             right column's text was clipped while the middle kept a wide gap. -->
        <FrameLayout
            android:id="@+id/main_center_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Fork (白い熊, +094): the label line — app name · note pill ·
                     debug star, as one horizontal row.

                     The note used to be a compound drawable on the label plus a
                     separate "+" floating over the column's top-right corner:
                     two different controls for one affordance, neither of which
                     could show what the note actually said. It is now ONE pill
                     in both states (RowPills.bindNote), right-aligned on this
                     line and exactly as wide as the tag "+" below it when empty,
                     so the two add controls stack into one column.

                     Sizing (白い熊, +095): the app name is `wrap_content` and
                     UNWEIGHTED — it takes its natural width, in full and not one
                     pixel more — while `note_slot` is the only weighted child, so
                     it absorbs every remaining pixel and the pill inside it
                     reaches back to exactly where the name ends. The one thing
                     weights cannot do is stop a name longer than the whole line
                     from leaving the slot nothing at all, so `LabelLineLayout`
                     caps the label a note-floor short of the line before
                     measuring. See that class — it is where the rule lives. -->
                <io.github.muntashirakon.AppManager.main.LabelLineLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textAppearance="?android:attr/textAppearanceListItem"
                        tools:text="@string/app_name" />

                    <!-- The debug star sits BEFORE the note pill, not after it:
                         it is always laid out (INVISIBLE, never GONE, for a
                         non-debuggable app), so trailing it would hold the pill
                         ~24dp off the column's end and the two add affordances
                         would no longer share an edge. -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/favorite_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/item_favorite"
                        tools:ignore="ContentDescription" />

                    <FrameLayout
                        android:id="@+id/note_slot"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/note_pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|center_vertical"
                            tools:text="Needed for X; do not freeze" />

                    </FrameLayout>

                </io.github.muntashirakon.AppManager.main.LabelLineLayout>

                <!-- Fork (白い熊, +096): the app-ID line — the kernel UID, then
                     the package name it belongs to.

                     The UID used to sit right-aligned and 10sp at the far end of
                     the date line below, where it read as a stray number
                     attached to the install date. It names the app, so it now
                     leads the app ID instead. It stays its OWN view rather than
                     becoming a span on the package name, so it keeps the font
                     category (FontPrefs.UID) and the colour rows
                     (ColorPrefs.UID_NORMAL / UID_SHARED — orange when the
                     package shares a user ID) it already had; a span would have
                     silently retired both settings surfaces.

                     The UID is wrap_content and the package name takes the slack
                     (0dp + weight), so a long ID is clipped at its own end
                     instead of pushing the number off the row. -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/shareid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:singleLine="true"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textStyle="italic"
                        tools:text="10123" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/packageName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textStyle="italic"
                        tools:text="io.github.muntashirakon.AppManager" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    tools:text="@tools:sample/date/mmddyy" />

                <!-- Fork (白い熊, +094): the tag (profile) line — memberships,
                     then the "+" that adds one.

                     The pills are RIGHT-aligned, against the same edge as the
                     note pill above them, so a row's annotations read as one
                     column instead of drifting apart. `fillViewport` is what
                     achieves it: it stretches the strip to the viewport when the
                     pills are narrower than the line, and `gravity="end"` then
                     pushes them to its end; when there are more pills than fit,
                     the strip keeps its own width and scrolls sideways instead
                     of wrapping onto a second line and costing every row its
                     height. The "+" sits OUTSIDE the scroller so it can never be
                     scrolled out of reach. -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <HorizontalScrollView
                        android:id="@+id/profile_pills_scroller"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fillViewport="true"
                        android:scrollbars="none">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/profile_pills"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end|center_vertical"
                            android:orientation="horizontal" />

                    </HorizontalScrollView>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/profile_add_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

        </FrameLayout>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/main_right_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/padding_small">

            <!-- Right column: stacked vertical rows. Each of the first three
                 rows is a horizontal pair - existing field on the left,
                 corresponding backup field flush at the right (yellow, gone
                 when no backup).

                 Fork (白い熊, +77): the pair used to split 50/50 (both children
                 layout_weight=1). Both halves were then wider than their text —
                 "System" in half a column, "long-press" in the other — so the
                 row carried a gap in the middle AND a gap at its end, and the
                 app label was ellipsized to pay for both. Now the BACKUP field
                 is wrap_content with weight 0, so it takes exactly its text and
                 the existing field (still 0dp + weight 1) absorbs the rest:
                 the backup values line up flush right, the existing values line
                 up flush left, and a long version string gets whatever the
                 backup side did not need instead of a fixed half.

                 The column's own width is no longer a share of the row either —
                 MainRecyclerAdapter.applyColumnProportions measures it from the
                 signature line below and pins it, handing the whole surplus to
                 the label column.

                 The pairings per spec:
                   row 1: version          / backed-up versionName
                   row 2: user-or-system   / backup date (YYYY-MM-DD)
                   row 3: SDK              / backup time (HH:MM:SS)
                 The 4th row (signature SHA) stays standalone, full-width.
                 The "apk+data" backup-flags line that used to sit at the
                 bottom was dropped at the user's request - the above three
                 rows replace it. -->

            <!-- Fork (白い熊, +173): the version has the line to ITSELF.
                 It used to share row 1 with the backup version (version at
                 weight 1, backup at wrap_content), which left a 36-43 character
                 fork version name about ten characters once a 9-character
                 backup version had taken its share - so the one field that
                 grew was the one being squeezed. The backup version now sits on
                 its own line directly beneath, still flush right and still
                 immediately under the installed version, so the comparison the
                 pair exists for - is my backup current? - is read down instead
                 of across and both get the full width of the column. -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="middle"
                android:textAppearance="?attr/textAppearanceBodySmall"
                tools:text="4.1.1+2026-09-05.03-37.g41d79af5+016" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/backup_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:singleLine="true"
                android:ellipsize="middle"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="3.1.9"
                tools:visibility="visible" />

            <!-- Fork: share-of-drain bar, used only by the battery screens
                 (MainCardBinder shows it when a battery row is bound). GONE by
                 default, so the main list is untouched. -->
            <FrameLayout
                android:id="@+id/battery_bar_track"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:background="#2A2A2A"
                android:visibility="gone">

                <View
                    android:id="@+id/battery_bar_fill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent" />

            </FrameLayout>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/isSystem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="User" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/backup_date"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/padding_small"
                    android:layout_weight="0"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="2026-05-18"
                    tools:visibility="visible" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/size"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="SDK 30" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/backup_time"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/padding_small"
                    android:layout_weight="0"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="21:01:06"
                    tools:visibility="visible" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/sha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textSize="11sp"
                tools:text="SHA256withRSA" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- The unrolled pane: facts this row cannot show, the action pills, and the backups.
         Filled by AppPaneBinder on bind; GONE for every row but the open one. -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/app_pane"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="?attr/listItemPaddingHorizontal"
        android:paddingBottom="10dp"
        android:visibility="gone"
        tools:visibility="visible" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</com.google.android.material.card.MaterialCardView>