<!-- Fork: a single pill-shaped dialog list item. The root MUST stay a TextView —
     ArrayAdapter binds straight onto the root when the layout is one, which is
     what lets the caller pass Spannables (e.g. a bold "Lock with device policy")
     with no adapter subclass of its own. -->
<androidx.appcompat.widget.AppCompatTextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_dialog_pill"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:paddingHorizontal="20dp"
    android:paddingVertical="10dp"
    android:textColor="@color/theme_bright_yellow"
    android:textSize="17sp" />
