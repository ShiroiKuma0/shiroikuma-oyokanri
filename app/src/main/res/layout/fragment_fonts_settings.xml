<!--
    Fonts settings screen. A scroll of group boxes; each group's content is
    populated programmatically with one font-element view per category. See
    FontsPreferences for the data-driven group/category build.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/fonts_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp" />

</ScrollView>
