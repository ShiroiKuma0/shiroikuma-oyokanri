<!--
    A font-settings group: a bold header with a full-width underline rule
    beneath it (HandyRSS treatment), then the element views added into
    group_content at runtime.
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="20dp"
    android:layout_marginBottom="6dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/group_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/theme_bright_yellow"
        android:textStyle="bold"
        android:textSize="22sp"
        tools:text="Reading view" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="4dp"
        android:background="@color/theme_bright_yellow" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/group_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</androidx.appcompat.widget.LinearLayoutCompat>
