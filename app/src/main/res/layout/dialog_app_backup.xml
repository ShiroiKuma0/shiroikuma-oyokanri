<!-- Fork: body of the main list's one-stop backup dialog (AppBackupDialogFragment).
     Everything the old two-step flow needed a second screen for lives here: the
     app's existing backups as a tick list, the actions that work on the ticked
     ones, and - as the dialog's own positive button - "Back up".
     The action row is a FlowLayout rather than a LinearLayout because three
     pills plus the dialog's own two do not fit one line on a narrow screen;
     wrapping is better than clipping. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/padding_medium">

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/padding_small"
        android:textColor="@color/theme_bright_yellow"
        android:textSize="15sp"
        android:visibility="gone"
        tools:text="No backups yet."
        tools:visibility="visible" />

    <!-- Fork (白い熊, +119): the list has to say what it is a list of. -->
    <TextView
        android:id="@+id/backups_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/padding_small"
        android:paddingBottom="6dp"
        android:text="@string/backups_existing"
        android:textAllCaps="true"
        android:textColor="@color/theme_bright_yellow"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

    <io.github.muntashirakon.widget.MaxHeightScrollView
        android:id="@+id/list_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:maxHeight="320dp"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/backup_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </io.github.muntashirakon.widget.MaxHeightScrollView>

    <io.github.muntashirakon.widget.FlowLayout
        android:id="@+id/backup_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingTop="@dimen/padding_small"
        android:visibility="gone"
        app:childSpacing="8dp"
        app:rowSpacing="4dp"
        tools:visibility="visible">

        <!-- Fork (白い熊): this used to be a ⋮ overflow whose entire contents was Freeze, which
             is not a backup action and had no business here. It is now Share, which is. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_share"
            style="@style/Widget.AppTheme.Button.Dialog.YellowOutlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/share"
            app:icon="@drawable/ic_share"
            app:iconGravity="textStart"
            app:iconTint="@color/theme_bright_yellow" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_delete"
            style="@style/Widget.AppTheme.Button.Dialog.YellowOutlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_restore"
            style="@style/Widget.AppTheme.Button.Dialog.YellowOutlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/restore" />

    </io.github.muntashirakon.widget.FlowLayout>

</LinearLayout>
