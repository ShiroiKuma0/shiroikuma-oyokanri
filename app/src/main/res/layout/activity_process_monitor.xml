<!--
    Fork: the process monitor / reaper screen (Phase 1). Live process list
    sorted by RAM (hoggers first), each row classified PROTECTED vs KILLABLE;
    tap a killable row to smart-kill it (app → force-stop, orphaned shell pid →
    SIGKILL). Live CPU sampling, leak grouping and bulk select land next.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".processreaper.ProcessMonitorActivity">

    <!-- Fork: scrolling top bar — this screen carries six action icons plus a
         title and subtitle, which a folded panel cannot show at once. -->
    <include layout="@layout/appbar_scrollable" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

    <!-- Fork: system-health header — uptime, free memory, paging, thermal, the
         graphics allocator, and apps holding destroyed screens or large GPU
         memory. Filled in code (ProcessMonitorActivity.bindHealth). -->
    <!-- Fork (白い熊, +063): the health header in the Snooping page's card language — a rounded
         outlined box; the stroke colour is set in code (ForkThemeUtils) like the Snooping cards. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/monitor_health_card"
        style="@style/Widget.AppTheme.CardView.ListItem.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        app:cardElevation="0dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/monitor_health"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp" />

    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <io.github.muntashirakon.widget.RecyclerView
            android:id="@+id/monitor_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:clipToPadding="false"
            android:fitsSystemWindows="true"
            tools:listitem="@layout/item_monitor_process" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/monitor_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="32dp"
            android:textColor="#9A9A9A"
            android:textSize="16sp"
            android:visibility="gone"
            android:text="@string/monitor_empty" />

    </FrameLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
