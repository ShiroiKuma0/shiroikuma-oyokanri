<!--
    Fork: the selected (checked) main-list card's frame. Same treatment as
    view_separator_element: bold sub-heading with a text-width underline,
    then INDENTED controls — border-width value + slider (0.5dp steps),
    corner-roundness value + slider (1dp steps), and a colour row added
    programmatically into color_rows.
-->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="16dp">

    <!-- kxkb ladder: sub-heading 54dp; controls below at 72dp. -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="54dp"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/element_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/theme_bright_yellow"
            android:textStyle="bold"
            android:textSize="17sp"
            tools:text="Frame" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="2dp"
            android:background="@color/theme_bright_yellow" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:paddingStart="72dp"
        android:paddingEnd="16dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pref_selframe_width"
            android:textColor="#9A9A9A"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/frame_width_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="2dp"
            android:textColor="@color/theme_bright_yellow"
            android:textSize="17sp"
            tools:text="4.0 dp" />

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/frame_width_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/pref_selframe_radius"
            android:textColor="#9A9A9A"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/frame_radius_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="2dp"
            android:textColor="@color/theme_bright_yellow"
            android:textSize="17sp"
            tools:text="24 dp" />

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/frame_radius_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/color_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
