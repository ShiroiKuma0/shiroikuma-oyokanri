<!--
    Fork (白い熊, +116): the full-page view of a running batch operation, replacing the one-line
    progress dialog. Fixed header (counts, current apps, bytes) over a live log that keeps
    scrolling, and a bottom bar whose buttons change role when the operation ends.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".batchops.BatchOpsProgressActivity">

    <include layout="@layout/appbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:orientation="vertical"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <!-- Header: what the batch as a whole is doing. Two rows tall, fixed. -->
        <LinearLayout
            android:id="@+id/op_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/op_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="12 / 42 · 3 failed · 4m 18s · 1.2 GB" />

            <!-- Fork (白い熊, +130): NO line cap. One line per app in flight, however many that
                 is — at maxLines="2" six of eight running apps were silently dropped and a busy
                 batch looked half-idle. The header grows with the work and shrinks back. -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/op_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:textSize="13sp"
                tools:text="白い熊 ArcaneChat · App-supplied data" />

        </LinearLayout>

        <View
            android:id="@+id/op_header_rule"
            android:layout_width="match_parent"
            android:layout_height="1px" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/op_log"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:scrollbars="vertical" />

            <!-- Shown only when the log has been scrolled away from the bottom. -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/op_follow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:text="@string/op_log_follow"
                android:visibility="gone" />

        </FrameLayout>

        <View
            android:id="@+id/op_bar_rule"
            android:layout_width="match_parent"
            android:layout_height="1px" />

        <!-- Fork (白い熊, +28): a FlowLayout, not a row. The finished bar carries four pills
             now — Copy log · Save log · Share log · Close — and in Japanese those are four
             six-character labels that cannot share one line on the folded panel. A LinearLayout
             would have squeezed and ellipsized all four rather than dropping one to a second
             row, which is the one failure a bar of controls cannot afford. -->
        <io.github.muntashirakon.widget.FlowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp"
            app:childSpacing="10dp"
            app:rowSpacing="8dp">

            <!-- Fork (白い熊): send the backup that was just made to 白い熊 魔法絨毯. First, and
                 so left-most, because on the finished bar it is the only pill that acts on the
                 BACKUP rather than on the log — the three log pills and Close follow it. Shown
                 only after a backup, never after a restore or a delete, where there is nothing
                 newly made to carry. -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/op_send"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="@string/share_backup_send"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/op_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="@string/pause" />

            <!-- Fork (白い熊, +132): leaving is not cancelling, and the page has to say so.
                 Back already only closed the page — the operation runs in a foreground service
                 and never noticed — but with Cancel as the only visible way out, that was
                 something you had to risk a backup to find out. -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/op_tertiary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="@string/op_leave_running"
                tools:visibility="visible" />

            <!-- Fork (白い熊, +28): the two ways the log leaves the phone. Save was in the
                 overflow already, which is exactly where nobody looks once the batch has ended
                 and the log is the only thing left on screen; Share is new. Both appear only in
                 the finished state, beside Copy, since that is when a log is worth keeping. -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/op_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="@string/op_log_save"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/op_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="@string/op_log_share"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/op_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="@android:string/cancel" />

        </io.github.muntashirakon.widget.FlowLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
