<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: one capability row of the app-details Snooping tab. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.AppTheme.CardView.ListItem.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="?attr/listItemMarginHorizontal"
    android:layout_marginVertical="?attr/listItemMarginVertical"
    android:focusable="true"
    app:cardElevation="0dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="?attr/listItemPaddingHorizontal"
        android:paddingVertical="?attr/listItemPaddingVertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/snooping_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceListItem"
                tools:text="Precise location" />

            <!-- Fork: both descriptive lines sit on a tinted chip rather than
                 bare on the pure-black page — small coloured text (especially the
                 red "Allowed" state) was barely legible without it. -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/snooping_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_snooping_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Blocked · saved" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/snooping_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_snooping_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textIsSelectable="true"
                android:textSize="13sp"
                tools:text="ACCESS_FINE_LOCATION" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Fork: the device-policy padlock, in a column of its own to the LEFT of
             the toggle and as tall as it. It began as a compound drawable on the
             label, which made it small, ragged down the list, and awkward to hit;
             a real column lines every lock up and gives it a proper tap target.

             The padding is not decoration (白い熊, +80): the "remembered" ring is
             drawn as this view's BACKGROUND, i.e. at its bounds, and a stadium at
             48×32 cuts straight through the corners of a glyph that fills them.
             The padding is what holds the glyph inside the curve.

             48dp wide, not 40 (白い熊, +83). The glyph is a 24dp square, so at 40dp
             it left only 8dp of slack on each side: aim at the padlock, overshoot
             by a finger's width to the right, and the tap lands past the view on
             the card — whose click ADVANCES THE CAPABILITY. Missing a lock and
             changing a permission instead is the worst possible way to miss.
             `ItemViewHolder#applyLockTouchDelegate` widens the hit rect further
             still, over the gap up to the switch and the row's whole height. -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/snooping_lock"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_weight="0"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/policy_lock"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            tools:src="@drawable/ic_unlock"
            tools:visibility="visible" />

        <!-- Fork: wrap_content + padding, NOT a fixed width (白い熊, +71). The
             "remembered" box is drawn as this view's BACKGROUND, so the view's
             own bounds are the box: at the old 56dp the M3 track (52dp) filled
             them and the two outlines merged into one, and the thicker red drift
             box appeared to bleed over the track. Padding is what puts air
             between them — and it must be the padding rather than a wider fixed
             width, because SwitchCompat ignores horizontal gravity and always
             draws the track at the padding edge, so any spare width would land
             on one side only. wrap_content then measures to track + padding,
             symmetric by construction, and every row still lines up because they
             all measure the same. The padding is unconditional so a row with a
             box and one without hold their switch in exactly the same place. -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/snooping_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="0"
            android:clickable="false"
            android:focusable="false"
            android:paddingHorizontal="7dp"
            android:paddingVertical="6dp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</com.google.android.material.card.MaterialCardView>
