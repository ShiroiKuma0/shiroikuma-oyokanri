<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: one capability row of the app-details Snooping tab. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.AppTheme.CardView.ListItem.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="?attr/listItemMarginHorizontal"
    android:layout_marginVertical="?attr/listItemMarginVertical"
    android:focusable="true"
    app:cardElevation="0dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="?attr/listItemPaddingHorizontal"
        android:paddingVertical="?attr/listItemPaddingVertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/snooping_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceListItem"
                tools:text="Precise location" />

            <!-- Fork: both descriptive lines sit on a tinted chip rather than
                 bare on the pure-black page — small coloured text (especially the
                 red "Allowed" state) was barely legible without it. -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/snooping_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_snooping_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Blocked · saved" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/snooping_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_snooping_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textIsSelectable="true"
                android:textSize="13sp"
                tools:text="ACCESS_FINE_LOCATION" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Fork: the device-policy padlock, in a column of its own to the LEFT of
             the toggle and as tall as it. It began as a compound drawable on the
             label, which made it small, ragged down the list, and awkward to hit;
             a real column lines every lock up and gives it a proper tap target. -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/snooping_lock"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_weight="0"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/policy_lock"
            android:scaleType="fitCenter"
            android:visibility="gone"
            tools:src="@drawable/ic_unlock"
            tools:visibility="visible" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/snooping_toggle"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="0"
            android:clickable="false"
            android:focusable="false" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</com.google.android.material.card.MaterialCardView>
