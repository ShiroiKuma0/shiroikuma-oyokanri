<!-- Fork (白い熊, APK-vetting chain, item 5; reshaped +081): the VirusTotal scan-and-report DIALOG.
     The activity's window is translucent and dimmed (AppTheme.YellowOnBlack.Floating); this root
     insets a single panel — black, rounded, framed in the fork's ink (painted in code) — that is
     almost as big as the page. The header, the hairline and the sections are built or tinted in
     code so every colour comes from the configurable fork theme. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/vt_report_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".scanner.vt.VtReportActivity">

    <LinearLayout
        android:id="@+id/vt_report_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="14dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/vt_report_logo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                app:srcCompat="@drawable/ic_vt" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/vt_report_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/vt_report_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/virus_total"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <View
            android:id="@+id/vt_report_hairline"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/vt_report_scroller"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/vt_report_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="18dp" />
        </androidx.core.widget.NestedScrollView>

        <!-- Fork (白い熊, +082): every decision is made here, at the foot of the dialog — the
             actions of the current state in one row, a full-width Cancel under them. Filled in code. -->
        <View
            android:id="@+id/vt_report_hairline_bottom"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/vt_report_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp" />
    </LinearLayout>
</FrameLayout>
