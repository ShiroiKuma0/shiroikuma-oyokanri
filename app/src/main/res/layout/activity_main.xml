<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_screen_bg"
    tools:context="io.github.muntashirakon.AppManager.main.MainActivity">

    <io.github.muntashirakon.widget.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/black"
        android:fitsSystemWindows="true"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@+id/item_list">

        <!-- Fork: the top bar scrolls left/right instead of dropping things.
             Every action here is showAsAction="always" and the search field is
             the toolbar's custom view with MATCH_PARENT width, so on a narrow
             (folded) panel the icons ate the whole bar and squeezed the search
             field down to its bare search-type button — it looked like the
             search bar had vanished. Inside a HorizontalScrollView the toolbar
             is measured UNSPECIFIED, i.e. at its natural width, so nothing is
             squeezed and the overflowing end is reached by scrolling.
             fillViewport="true" keeps the old behaviour whenever the bar does
             fit: the child is then re-measured EXACTLY at the viewport width
             and the MATCH_PARENT search field stretches across the free space
             as before. -->
        <HorizontalScrollView
            android:id="@+id/toolbar_scroller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="wrap_content"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="@null"
                app:popupTheme="@style/ThemeOverlay.AppManager.PopupMenu"
                tools:menu="@menu/activity_main_actions" />

        </HorizontalScrollView>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_linear"
            style="@style/Widget.AppTheme.LinearProgressIndicator"
            android:indeterminate="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </io.github.muntashirakon.widget.AppBarLayout>

    <io.github.muntashirakon.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <!-- Fork: black list background (same as the cards) so no grey ever
             shows between or under the edge-to-edge cells. -->
        <io.github.muntashirakon.widget.RecyclerView
            android:id="@+id/item_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:scrollbars="none"
            android:focusable="false"
            android:clipToPadding="false"
            android:fitsSystemWindows="true"
            app:fastScrollerEnabled="true"
            tools:listitem="@layout/item_main" />

    </io.github.muntashirakon.widget.SwipeRefreshLayout>

    <io.github.muntashirakon.widget.MultiSelectionView
        android:id="@+id/selection_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:focusable="false"
        app:cardBackgroundColor="@android:color/black"
        app:cardElevation="0dp"
        app:menu="@menu/activity_main_selection_actions" />

    <!-- Fork: floating selection reminder. Sits just above the selection action
         toolbar (its bottom margin is set in code to the toolbar's height) and is
         shown whenever the selection is non-empty. Tap the body to list the
         selected apps; tap the ✕ to clear the whole selection. The pill
         background, text and icon colours are applied at runtime from the
         configurable fork theme (ForkThemeUtils). Kept last so it floats on top. -->
    <LinearLayout
        android:id="@+id/selection_reminder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/selection_reminder_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/selection_reminder_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_circle" />

            <TextView
                android:id="@+id/selection_reminder_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="100 selected · 70 hidden" />
        </LinearLayout>

        <ImageView
            android:id="@+id/selection_reminder_clear"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/clear_all"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_close_24dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>