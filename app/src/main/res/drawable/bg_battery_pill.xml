<!-- Fork: the rounded outline used for the battery panel's control pills and
     the drainer-window selector. Transparent fill so the black page shows
     through; the stroke is the fork yellow. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="@color/theme_bright_yellow" />
    <corners android:radius="18dp" />
    <padding
        android:bottom="6dp"
        android:left="14dp"
        android:right="14dp"
        android:top="6dp" />
</shape>
