<resources>
    <color name="fm_icon_background">@color/m3_sys_color_light_on_surface_variant</color>
    <color name="fm_symbolic_link">#f37785</color>

    <color name="widget_text_primary">#1b1b1b</color>
    <color name="widget_text_secondary">#565e71</color>

    <color name="widget_screen_time_app1_bg">#1b1b1b</color>
    <color name="widget_screen_time_app1_fg">#ffffff</color>

    <color name="widget_screen_time_app2_bg">#565e71</color>
    <color name="widget_screen_time_app2_fg">#ffffff</color>

    <color name="widget_screen_time_app3_bg">#d4e3ff</color>
    <color name="widget_screen_time_app3_fg">#1b1b1b</color>

    <!-- Main-screen theme palette (custom fork). Subjective values for
         shades 'muted yellow' / grey / 'greyish orange' / screen-bg grey
         live here so they can be tweaked in one place. theme_ice_blue is
         the "frozen" indicator colour (snowflake + label) introduced when
         outline/filled drawable swap alone proved too subtle. -->
    <color name="theme_bright_yellow">#FFFF00</color>
    <color name="theme_bright_orange">#FF7A1A</color>
    <color name="theme_muted_yellow">#B8B800</color>
    <color name="theme_ice_blue">#A8D8E8</color>
    <color name="theme_label_frozen_user">#888888</color>
    <color name="theme_label_frozen_system">#A07A5A</color>
    <color name="theme_screen_bg">#1F1F1F</color>
    <!-- Fork: dormant-row "films" painted as the card background (cards are
         normally black). Desaturated, opaque, deliberately faint so the
         yellow/orange label text on top stays legible. Cool slate-cyan marks
         frozen rows; dusty mauve marks uninstalled rows — two different
         temperatures so the categories read apart at a glance. -->
    <color name="theme_film_frozen">#15242E</color>
    <color name="theme_film_uninstalled">#241826</color>
    <!-- Fork, +81: suspended is a THIRD dormant state, and the strongest one —
         the app cannot be opened at all and the system shows a stub in its
         place. It is a kind of frozen, so it keeps the italic and the film, but
         it needs to read apart from an ordinary freeze at a glance. Violet: not
         the cool cyan of frozen, not the mauve of uninstalled, and nowhere else
         on the row. The film is deliberately a shade heavier than the other two
         — this is the deepest "off" a row can be. -->
    <color name="theme_violet">#C77DFF</color>
    <color name="theme_film_suspended">#2A1440</color>

    <!-- Fork (白い熊, +034): the freeze LADDER, one colour per gate.

         A freeze stopped being one state the moment each of its four gates got
         its own switch, so the row stopped being able to say which one you are
         looking at. These are that answer: a ramp read as one gradient, cool and
         light at step 1, deep violet at step 4, so "how hard is this app shut"
         is legible without reading anything. The row wears the colour of the
         HIGHEST gate standing.

         Step 1 (force-stop) has an accent but NO film: an app that is merely
         stopped is not frozen — anything that opens it clears the mark — so the
         row stays an ordinary row and only the badge on the snowflake says so.
         It is therefore the fork's own YELLOW (白い熊, +035): the badge sits on a
         thawed snowflake, that snowflake is yellow, and giving the badge a cool
         tint of its own made the row look half-frozen when it is not frozen at
         all. The ladder proper starts at step 2, where the freezing starts.
         The deepest rung keeps the violet +81 gave suspension, because that is
         the colour this app has always used for "as shut as it gets". -->
    <color name="theme_freeze_1">#FFFF00</color>
    <color name="theme_freeze_2">#7FB3FF</color>
    <color name="theme_freeze_3">#B07DFF</color>
    <color name="theme_freeze_4">#E45BFF</color>
    <color name="theme_film_freeze_2">#122038</color>
    <color name="theme_film_freeze_3">#1F1440</color>
    <color name="theme_film_freeze_4">#33103A</color>
</resources>
