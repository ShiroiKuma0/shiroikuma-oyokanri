<resources>

    <style name="AppTheme.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">?attr/colorSurface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <style name="AppTheme.Splash.Black" parent="AppTheme.Splash">
        <item name="postSplashScreenTheme">@style/AppTheme.Black</item>
    </style>

    <style name="AppTheme.AppWidgetContainerParent" parent="AppTheme">
        <item name="appWidgetRadius">24dp</item>
        <item name="appWidgetPadding">16dp</item>
        <item name="appWidgetInnerRadius">4dp</item>
    </style>

    <style name="AppTheme.AppWidgetContainer" parent="AppTheme.AppWidgetContainerParent" />

    <style name="AppTheme.AppWidgetContainer.IconOnly" parent="AppTheme.AppWidgetContainerParent">
        <item name="appWidgetPadding">8dp</item>
        <item name="appWidgetRadius">8dp</item>
    </style>

    <style name="Widget.AppTheme.AppWidgetOverlay" parent="android:Widget">
        <item name="android:id">@android:id/background</item>
        <item name="android:background">?android:attr/colorBackground</item>
        <item name="android:padding">?attr/appWidgetPadding</item>
    </style>

    <style name="Widget.AppTheme.AppWidget" parent="Widget.AppTheme.AppWidgetOverlay" />

    <style name="Widget.AppTheme.BarChartView" parent="android:Widget">
        <!-- Bar appearance -->
        <item name="barColor">?attr/colorPrimaryContainer</item>
        <item name="selectedBarColor">?attr/colorPrimary</item>
        <item name="minBarWidth">8dp</item>
        <item name="maxBarWidth">24dp</item>
        <item name="valueOnTopOfBar">false</item>

        <!-- Grid appearance -->
        <item name="gridColor">?attr/colorOutline</item>
        <item name="gridStrokeWidth">1dp</item>
        <item name="gridLineCount">6</item>
        <item name="gridLabelsOnLeft">true</item>

        <!-- Label appearance -->
        <item name="textColor">?attr/colorOutline</item>
        <item name="textSize">@dimen/font_size_medium</item>
        <item name="yAxisFormat">@null</item>
        <item name="emptyText">@string/no_usage_in_this_time_range</item>

        <!-- Touch line appearance -->
        <item name="touchLineColor">?attr/colorOutline</item>
        <item name="touchLineWidth">2dp</item>

        <!-- Tooltip appearance -->
        <item name="tooltipBackgroundColor">?attr/colorSurfaceInverse</item>
        <item name="tooltipTextColor">?attr/colorOnSurfaceInverse</item>
        <item name="tooltipCornerRadius">6dp</item>
    </style>

    <style name="ThemeOverlay.AppManager.PopupMenu" parent="ThemeOverlay.Material3">
        <item name="popupMenuBackground">@drawable/popup_menu_background_black</item>
        <item name="colorOnSurface">@color/theme_bright_yellow</item>
        <item name="colorOnSurfaceVariant">@color/theme_bright_yellow</item>
        <item name="colorControlNormal">@color/theme_bright_yellow</item>
        <item name="android:textColorPrimary">@color/theme_bright_yellow</item>
        <item name="android:textColorSecondary">@color/theme_bright_yellow</item>
        <item name="actionMenuTextColor">@color/theme_bright_yellow</item>
    </style>

    <style name="AppTheme.YellowOnBlack" parent="AppTheme">
        <item name="colorPrimary">@color/theme_bright_yellow</item>
        <item name="colorOnPrimary">@android:color/black</item>
        <item name="colorPrimaryContainer">@color/theme_bright_yellow</item>
        <item name="colorOnPrimaryContainer">@android:color/black</item>
        <!-- Material 3 Chip's checked-state background and text read from
             colorSecondaryContainer / colorOnSecondaryContainer (see the
             m3_chip_background_color and m3_chip_text_color selectors in
             the M3 library). With those left at their M3 defaults, every
             selected sort/filter chip and our new In/Not-in chips render
             with a purple-tinted grey fill and dark text - jarring against
             the rest of the yellow-on-black palette. Pin both to our
             yellow/black pair so the checked state matches the unchecked
             outline. Side effect: FABs and tonal buttons that source from
             these attrs also gain the yellow look, which is consistent
             with the fork. -->
        <item name="colorSecondaryContainer">@color/theme_bright_yellow</item>
        <item name="colorOnSecondaryContainer">@android:color/black</item>
        <item name="colorOnSurface">@color/theme_bright_yellow</item>
        <item name="colorOnSurfaceVariant">@color/theme_bright_yellow</item>
        <item name="colorControlNormal">@color/theme_bright_yellow</item>
        <item name="colorOutline">@color/theme_bright_yellow</item>
        <item name="android:textColorPrimary">@color/theme_bright_yellow</item>
        <item name="android:textColorSecondary">@color/theme_bright_yellow</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="colorSurfaceContainer">@android:color/black</item>
        <item name="colorSurfaceContainerLow">@android:color/black</item>
        <item name="colorSurfaceContainerLowest">@android:color/black</item>
        <item name="colorSurfaceContainerHigh">@android:color/black</item>
        <item name="colorSurfaceContainerHighest">@android:color/black</item>
        <item name="popupMenuBackground">@drawable/popup_menu_background_black</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.AppTheme.MaterialAlertDialog.YellowOnBlack</item>
        <!--
        Disable M3's tonal elevation overlay system wholesale on this theme.
        Material 3 dialogs and other elevated surfaces construct their
        background as a MaterialShapeDrawable programmatically and call
        initializeElevationOverlay(context) on it. That provider reads:
          - elevationOverlayEnabled (defaults true on Material3 dark themes)
          - elevationOverlayColor (defaults ?attr/colorOnSurface — which we
            override to yellow above; this is the olive source)
        With overlay enabled and colorOnSurface = yellow, every elevated
        MaterialShapeDrawable composites yellow-onto-black at an
        elevation-derived alpha, producing the persistent olive cast that
        survived four previous attempts (drawable shadowing, windowBackground
        override, alertDialogStyle.background override, plain colour pins).
        Setting elevationOverlayEnabled = false short-circuits the
        compositeOverlayIfNeeded path entirely. elevationOverlayColor=black is
        a defensive backup in case some code reads the colour without
        consulting the gate.

        These are Material-library attrs (not framework), no android: prefix
        needed. Separate from colorSurfaceTint which is framework in API 31+
        and would need android:colorSurfaceTint with the prefix - that name
        without prefix is what caused the build failures in v3/v4.
        -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="elevationOverlayColor">@android:color/black</item>
    </style>

    <!-- Dialog theme overlay for MaterialAlertDialogs under
         AppTheme.YellowOnBlack. The default M3 dialog window background is a
         MaterialShapeDrawable with a tonal elevation overlay, which on a
         yellow primary produces an olive tint over the (supposedly) black
         surface. Two layers need overriding because M3 dialogs use them
         both: android:windowBackground (the Window's drawable) AND
         alertDialogStyle.background (the dialog component's visible
         surface, defined on MaterialAlertDialog.MaterialComponents in the
         M3 library as @drawable/mtrl_alert_dialog_background, which is the
         MaterialShapeDrawable that produces the olive). Pointing both at our
         plain <shape> GradientDrawable bypasses MaterialShapeDrawable on
         both layers - the dialog now renders as pure black with a yellow
         hairline stroke. -->
    <style name="ThemeOverlay.AppTheme.MaterialAlertDialog.YellowOnBlack" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/alert_dialog_bg_yellow_on_black</item>
        <item name="alertDialogStyle">@style/MaterialAlertDialog.AppTheme.YellowOnBlack</item>
        <!-- Fork: the SELECTED control state (radio dot/ring, checkbox, switch)
             defaults to the M3 accent and reads grey on this palette. Pin the
             activated colour to yellow so single-choice dialog radios match. -->
        <item name="colorControlActivated">@color/theme_bright_yellow</item>
        <item name="android:colorControlActivated">@color/theme_bright_yellow</item>
        <item name="colorAccent">@color/theme_bright_yellow</item>
    </style>

    <style name="MaterialAlertDialog.AppTheme.YellowOnBlack" parent="MaterialAlertDialog.Material3">
        <item name="background">@drawable/alert_dialog_bg_yellow_on_black</item>
    </style>

    <!-- Shadows libcore's Widget.AppTheme.MultiSelectionActionsView. The
         libcore version's android:background and item tints reference fixed
         M3 colour resources (m3_comp_nav_bar_container_color and
         m3_textfield_indicator_text_color) which do not follow theme
         attributes, so the bottom selection toolbar stays grey even when the
         activity uses AppTheme.YellowOnBlack. Pinning the background to
         black and the item tints to bright yellow here forces it to match. -->
    <style name="Widget.AppTheme.MultiSelectionActionsView" parent="android:Widget">
        <item name="android:background">@drawable/multi_selection_actions_bg_black</item>
        <item name="backgroundTint">@null</item>
        <item name="elevation">@dimen/m3_sys_elevation_level2</item>
        <item name="itemTextAppearanceInactive">?attr/textAppearanceBodyMedium</item>
        <item name="itemTextAppearanceActive">?attr/textAppearanceBodyMedium</item>
        <item name="itemIconSize">24dp</item>
        <item name="itemIconTint">@color/theme_bright_yellow</item>
        <item name="itemTextColor">@color/theme_bright_yellow</item>
        <item name="enforceTextAppearance">true</item>
        <item name="enforceMaterialTheme">true</item>
        <item name="itemBackground">@null</item>
        <item name="itemHorizontalTranslationEnabled">false</item>
    </style>
</resources>
